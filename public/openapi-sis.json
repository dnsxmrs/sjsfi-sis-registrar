{
    "openapi": "3.0.0",
    "info": {
        "title": "SJSFI SIS API",
        "version": "1.0.0",
        "description": "OpenAPI documentation for the SJSFI SIS endpoint."
    },
    "paths": {
        "/api/up": {
            "get": {
                "tags": [
                    "UP"
                ],
                "summary": "Health check for the SIS API.",
                "description": "Returns a simple status response to indicate the API is up.",
                "responses": {
                    "200": {
                        "description": "API is up and running.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpSuccessResponse"
                                },
                                "examples": {
                                    "success": {
                                        "value": {
                                            "message": "Database connection is healthy"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Database connection failed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpErrorResponse"
                                },
                                "examples": {
                                    "error": {
                                        "value": {
                                            "message": "Database connection failed",
                                            "error": "Some error message"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/hrms/available-schedules": {
            "post": {
                "tags": [
                    "Schedules"
                ],
                "summary": "Fetch all available schedules for HRMS faculty assignment.",
                "description": "Returns all available schedules in SIS for HRMS to assign faculty. Requires API key and signature headers.",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AvailableSchedulesRequest"
                            },
                            "examples": {
                                "default": {
                                    "value": {
                                        "data": "any-string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "All available schedules retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AvailableSchedulesResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized (missing or invalid API key).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden (invalid signature or HTTPS required).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests (rate limited).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server error.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/hrms/assign-teacher": {
            "post": {
                "tags": [
                    "Teacher Assignment"
                ],
                "summary": "Assign a teacher to a schedule.",
                "description": "Assigns a teacher to a schedule in SIS. Requires API key and signature headers.",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AssignTeacherRequest"
                            },
                            "examples": {
                                "default": {
                                    "value": {
                                        "scheduleId": 1,
                                        "teacher": {
                                            "teacherId": "T123",
                                            "teacherName": "Juan Dela Cruz",
                                            "teacherEmail": "juan.delacruz@email.com"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Teacher assigned or updated successfully.",
